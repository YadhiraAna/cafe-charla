#!/usr/bin/env python3
"""
Extracción y limpieza de datos de un portal oficial.
Selenium: búsqueda + filtro + paginación | Pandas: limpieza y estructura.
Uso ético: solo datos públicos, con pausas, sin evadir CAPTCHA.
"""
import random
import time
import pandas as pd
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait, Select
from selenium.webdriver.support import expected_conditions as EC
from selenium.common.exceptions import TimeoutException, NoSuchElementException

# ============ CONFIGURACIÓN (AJUSTAR) ============
CONFIG = {
    "url": "https://www.eluniversal.com.mx/",          # AJUSTAR
    "termino": "educación",                                   # AJUSTAR: texto a buscar
    "filtro_valor": "2024",                                   # AJUSTAR: valor del filtro
    "max_paginas": 5,                                         # límite de seguridad
    "timeout": 15,
    # Localizadores (obtenerlos con F12 → Inspeccionar)
    "sel_buscador":  (By.CSS_SELECTOR, "input#buscar"),       # AJUSTAR
    "sel_boton":     (By.CSS_SELECTOR, "button[type='submit']"),  # AJUSTAR
    "sel_filtro":    (By.CSS_SELECTOR, "select#anio"),        # AJUSTAR
    "sel_filas":     (By.CSS_SELECTOR, "table.resultados tbody tr"),  # AJUSTAR
    "sel_siguiente": (By.XPATH, "//a[contains(text(),'Siguiente') and not(contains(@class,'disabled'))]"),  # AJUSTAR
}
# Índices de columna dentro de cada fila (td). AJUSTAR según la tabla del portal
COLUMNAS = {"titulo": 0, "categoria": 1, "fecha": 2, "monto": 3}


# ============ UTILIDADES ============
def pausa(a=1.5, b=3.5):
    """Pausa aleatoria entre acciones (comportamiento respetuoso con el servidor)."""
    time.sleep(random.uniform(a, b))


def crear_driver():
    o = Options()
    o.add_argument("--window-size=1366,900")
    o.add_argument("--lang=es-MX")
    return webdriver.Chrome(options=o)


def hay_desafio(driver):
    """Detecta CAPTCHA o verificación. NO lo resuelve: solo avisa."""
    html = driver.page_source.lower()
    senales = ["recaptcha", "hcaptcha", "turnstile", "verifica que eres humano", "captcha"]
    return any(s in html for s in senales)


def intervencion_humana(driver):
    """Si aparece un desafío, el script se detiene y espera a que lo resuelva una persona."""
    if hay_desafio(driver):
        print("\n[!] Se detectó un desafío (CAPTCHA/verificación).")
        print("    Resuélvelo manualmente en el navegador y presiona ENTER para continuar...")
        input()


# ============ NAVEGACIÓN ============
def buscar_y_filtrar(driver, wait):
    driver.get(CONFIG["url"])
    intervencion_humana(driver)

    caja = wait.until(EC.element_to_be_clickable(CONFIG["sel_buscador"]))
    caja.clear()
    caja.send_keys(CONFIG["termino"])

    # Filtro tipo <select>. Si es otro control (botones, checkboxes), cambia esta parte
    filtro = wait.until(EC.presence_of_element_located(CONFIG["sel_filtro"]))
    Select(filtro).select_by_visible_text(CONFIG["filtro_valor"])

    wait.until(EC.element_to_be_clickable(CONFIG["sel_boton"])).click()
    wait.until(EC.presence_of_all_elements_located(CONFIG["sel_filas"]))  # espera resultados
    pausa()


def extraer_pagina(driver):
    """Extrae las filas de la página actual y devuelve una lista de diccionarios (datos crudos)."""
    registros = []
    for fila in driver.find_elements(*CONFIG["sel_filas"]):
        celdas = fila.find_elements(By.TAG_NAME, "td")
        if len(celdas) < len(COLUMNAS):
            continue
        registros.append({
            nombre: celdas[i].text for nombre, i in COLUMNAS.items()
        })
    return registros


def paginar(driver, wait):
    """Recorre las páginas hasta que no exista el botón 'Siguiente' o se alcance el límite."""
    todos = []
    for pagina in range(1, CONFIG["max_paginas"] + 1):
        intervencion_humana(driver)
        wait.until(EC.presence_of_all_elements_located(CONFIG["sel_filas"]))
        datos = extraer_pagina(driver)
        todos.extend(datos)
        print(f"Página {pagina}: {len(datos)} registros (acumulado: {len(todos)})")

        try:
            siguiente = driver.find_element(*CONFIG["sel_siguiente"])
        except NoSuchElementException:
            print("No hay más páginas.")
            break
        primera_fila = driver.find_element(*CONFIG["sel_filas"])     # para detectar el cambio de página
        siguiente.click()
        try:
            wait.until(EC.staleness_of(primera_fila))               # espera a que la tabla se recargue
        except TimeoutException:
            print("La tabla no cambió; se detiene la paginación.")
            break
        pausa()
    return todos


# ============ PANDAS: ESTRUCTURA Y LIMPIEZA ============
def limpiar(registros):
    df = pd.DataFrame(registros)
    print("\n--- DATOS CRUDOS ---")
    print(df.head(10))
    print(f"Filas: {len(df)} | Nulos por columna:\n{df.replace('', pd.NA).isna().sum()}")

    # 1) Texto: quitar espacios, saltos de línea y estandarizar mayúsculas
    for col in ["titulo", "categoria"]:
        df[col] = (df[col].astype(str)
                          .str.replace(r"\s+", " ", regex=True)
                          .str.strip()
                          .str.title())

    # 2) Vacíos → nulos y eliminar filas sin datos clave
    df = df.replace(r"^\s*$", pd.NA, regex=True)
    df = df.dropna(subset=["titulo", "fecha"])

    # 3) Fechas a formato datetime (dd/mm/aaaa del portal)
    df["fecha"] = pd.to_datetime(df["fecha"], dayfirst=True, errors="coerce")
    df = df.dropna(subset=["fecha"])

    # 4) Montos: quitar $ y comas y convertir a número
    df["monto"] = (df["monto"].astype(str)
                              .str.replace(r"[^\d.\-]", "", regex=True)
                              .replace("", pd.NA))
    df["monto"] = pd.to_numeric(df["monto"], errors="coerce")

    # 5) Duplicados y orden
    df = df.drop_duplicates().sort_values("fecha", ascending=False).reset_index(drop=True)
    return df


# ============ PRINCIPAL ============
def main():
    driver = crear_driver()
    wait = WebDriverWait(driver, CONFIG["timeout"])
    try:
        buscar_y_filtrar(driver, wait)
        registros = paginar(driver, wait)
    except TimeoutException:
        print("[!] Tiempo de espera agotado. Revisa los selectores o si hay un desafío en pantalla.")
        registros = []
    finally:
        driver.quit()

    if not registros:
        print("No se extrajeron datos.")
        return

    df = limpiar(registros)
    print("\n--- DATOS PROCESADOS ---")
    print(df.head(15).to_string())
    print("\n--- INFO ---")
    df.info()
    print("\n--- RESUMEN ---")
    print(df.describe(include="all"))

    df.to_csv("datos_procesados.csv", index=False, encoding="utf-8-sig")
    print("\nGuardado en datos_procesados.csv")


if __name__ == "__main__":
    main()